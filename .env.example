# 복사해서 .env 로(set -a; source .env; set +a). .env 는 git 에 안 올라감.
# 코드가 읽는 환경 변수 전부. 빈 값 = 기본값. 표와 설명은 docs/deployment.md §1.

# --- 서버 ---
PORT=3000
# 비우면 127.0.0.1(이 컴퓨터에서만). 컨테이너 이미지는 0.0.0.0 — --env-file 로 쓸 때 빈 HOST= 줄은 지운다(이미지 값을 덮는다)
HOST=
# 같은 폴더에 접속기록 access.jsonl·미러 수신 상태 imap-state.json 이 생긴다(:memory: 면 둘 다 끔)
DB_PATH=data/cs-agent.db
# production 이면 INBOUND_SECRET·AUTH_USER_HEADER·PROXY_SHARED_SECRET 이 없을 때 시작 거부, MAIL_PROVIDER=mock 도 시작 거부(ALLOW_MOCK_MAIL=1 없을 때),
# REQUIRE_SENDER_AUTH 기본 켬. 발송 없는 로컬 시연은 비워 둔다(Docker 는 -e NODE_ENV= -e MAIL_PROVIDER=mock).
# 비워도 MAIL_PROVIDER=smtp + 루프백(127.0.0.1·::1·localhost) 아닌 HOST 면 세 시크릿이 없을 때 시작 거부
NODE_ENV=

# --- LLM: mock(네트워크 없음, 테스트용) | anthropic. 비우면 ANTHROPIC_API_KEY 있을 때 anthropic ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# 기본 claude-sonnet-5-5
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
# LLM 호출 하나의 제한 시간(ms, 기본 30000)
LLM_TIMEOUT_MS=
# 답장 Agent 방식: 비우면 react(툴을 골라 부르는 ReAct — 툴 목록은 docs/tools.md) | single(한 번 묻고 JSON)
RESPONDER_MODE=
# react 한 사이클의 LLM 걸음 상한(기본 6). 끝내는 툴 없이 닿으면 사람에게
REACT_MAX_STEPS=
# 접수 Agent가 받는 지식베이스: 비우면 full(KB 전체) | rag(고객 문의와 가까운 절 상위 KB_TOPK개 본문 + 목차). 답장·검수·guard는 늘 전체 KB
KB_MODE=
# rag에서 고를 절 수(기본 5, 1~50)
KB_TOPK=
# rag에서 목차(모든 절의 키·제목)도 줄지: 비우면 줌 | 0이면 고른 절 본문만
KB_TRIAGE_TOC=
# rag 임베딩 공급자: 비우면 mock(네트워크 없음, 이번 단계와 테스트용). Bedrock Cohere Embed v4는 다음 단계
EMBED_PROVIDER=
# rag 벡터 저장소: 비우면 memory(프로세스 메모리, 테스트용 — 기동 때 다시 색인) | pgvector(PostgreSQL + pgvector, KB 절 벡터만 — 운영 데이터는 SQLite)
VECTOR_STORE=
# VECTOR_STORE=pgvector일 때 접속 주소: postgresql://<사용자>:<비밀번호>@<호스트>:<포트>/<DB>. KB_MODE=rag인데 비어 있으면 시작 거부. full이면 접속하지 않는다
PGVECTOR_URL=
# 주문·결제·계정 조회와 담당자 빈 시간 툴의 원본(JSON 파일 경로, 시험용 목 데이터 server/mock/business-data.json). 비우면 네 툴을 숨긴다. 형식은 docs/tools.md
BUSINESS_DATA_FILE=
# 공식 사이트 읽기 툴이 열 수 있는 도메인(쉼표 목록, 하위 도메인 포함. 예: help.example.com,status.example.com). 비우면 툴을 숨긴다
OFFICIAL_SITE_DOMAINS=
# 장애 재시도 간격 배수(2·5·10·30분 × 이 값, 기본 1)
LLM_RETRY_SCALE=
# mock 응답 지연(ms). 대시보드에서 "돌아가는 중"을 보려면 1500
LLM_MOCK_DELAY_MS=
# 하루(UTC 기준 — 한국 시간 09:00 초기화) 입력+출력 토큰 상한. 넘으면 LLM 을 부르지 않고 바로 담당자에게 넘김. 비우면 무제한
LLM_DAILY_TOKEN_BUDGET=
# 백만 토큰당 USD 단가(리포트 비용 계산). 비우면 비용을 계산하지 않는다
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- 메일 발송: mock(DB 기록만) | smtp(실발송) ---
MAIL_PROVIDER=mock
# 실발송 수신자 도메인 허용 목록(쉼표). 비어 있으면 전체 차단
MAIL_ALLOWED_DOMAINS=
# production 에서 mock 메일을 일부러 쓸 때만 1(발송 없는 시연). 없으면 시작 거부
ALLOW_MOCK_MAIL=
SMTP_HOST=
# 기본 587(STARTTLS). SMTP_SECURE=1 이면 암묵 TLS(보통 465)
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# 보내는 주소 "이름 <addr>" 또는 addr
SMTP_FROM=
# 1 = STARTTLS 없이 평문 허용(로컬 테스트용)
SMTP_ALLOW_PLAIN=
# SMTP 단계별 제한 시간(ms, 기본 15000)
SMTP_TIMEOUT_MS=
# 0 = 자체 서명 인증서 허용
SMTP_TLS_REJECT_UNAUTHORIZED=
# mock 발송: 1 = 실패 재현 / 0 = 발송 로그 끔 / 발송 지연(ms)
MAIL_MOCK_FAIL=
MAIL_MOCK_LOG=
MAIL_MOCK_DELAY_MS=
# 비교 실험 전용 스위치 — 운영에선 비워 둔다. mock 메일일 때만 먹는다
CS_ABLATE=

# --- 메일 템플릿 ---
COMPANY_NAME=ACME
AGENT_NAME=Aria

# --- 인증·보안 ---
# 웹훅 POST /api/inbound 검증 헤더 x-inbound-secret. 비어 있으면 검증 안 함(로컬)
INBOUND_SECRET=
# 리버스 프록시가 넣는 사용자 헤더 이름(예: x-forwarded-user). 있으면 /api 전부(GET·SSE 포함, 웹훅·헬스체크 제외)에 필요, by 를 덮어씀
AUTH_USER_HEADER=
# 프록시가 모든 요청에 x-proxy-secret 헤더로 넣는 값. 있으면 그 헤더 없는 /api 요청(앱 포트 직결)은 401
PROXY_SHARED_SECRET=
# 1 = /api/test/inbound(대시보드 "테스트 문의"·sim) 켬. 비우면 개발(NODE_ENV 비움) + MAIL_PROVIDER=mock 일 때만 켜짐
ENABLE_TEST_INJECT=
# 발신자 인증 결과가 없는 메일에 자동 메일(L2 자동 발송·접수 안내)을 막는다. 비우면 production 에서 켬·그 밖에서 끔,
# 0·false·off·no 는 끔, 그 밖의 값은 켬. 인증 실패(fail)는 설정과 무관하게 항상 담당자에게 넘김. MAIL_PROVIDER=smtp 인데 끄면 기동 경고
REQUIRE_SENDER_AUTH=
# 쉼표 도메인. 이 도메인 발신은 문의 폼 메일 — Reply-To·제목·본문의 이메일 칸에서 고객 주소를 뽑는다.
# 뽑은 주소는 고객이 친 값이라 자동 메일 없이 사람 승인 초안만, 못 뽑으면 담당자에게 넘김
FORM_SENDER_DOMAINS=

# --- 고객 KB·정책 콘솔 · 감사 ---
# 콘솔에서 고칠 수 있는 관리자 이름(쉼표). 프록시가 사용자 헤더에 넣는 값과 같은 형식(이메일 또는 아이디). 대소문자·앞뒤 공백은 무시. 비우면 아무도 고칠 수 없다. 바꾸면 재시작
ADMIN_USERS=
# 감사 내보내기(scripts/audit-export.js)가 고객 주소를 가리는 HMAC 키. 32자 이상 필수. 바꾸면 내보낸 customer_hash 값이 달라진다. 운영 시크릿으로 보관
AUDIT_SALT=
# KB_CONVERT_PDF_TOKENS 는 환경 변수가 아니다. 매뉴얼 PDF 입력 상한 30000 토큰은 코드 상수(server/convert.js PDF_TOKEN_CAP)라 바꾸려면 코드를 고친다

# --- 운영 ---
# 쉼표 채널 이름. 정책 팩과 무관하게 섀도(L0) — 재빌드 없는 kill switch. 파일럿 권장: 받는 채널 전부(예: support)
SHADOW_CHANNELS=
# L2 자동 발송·넘김 접수 안내. 1·true·on·yes 또는 비우면 켬, 그 밖의 값(0·false·off)은 끔(L2 intent도 승인 대기) — 재빌드 없는 kill switch.
# MAIL_PROVIDER=smtp 인데 INBOUND_SECRET 이 비어 있으면 값과 상관없이 꺼진다. 파일럿 권장: 0
AUTO_SEND=
# Slack 호환 웹훅(넘김·승인 대기 알림, PII 없음)
NOTIFY_WEBHOOK_URL=
# 이 기간(일, 기본 30) 조용한 케이스를 자동 종결
AUTO_CLOSE_DAYS=
# 쉼표 도메인. 이 도메인 발신은 사내 메일로 보고 무시
INTERNAL_DOMAINS=
# 종결 뒤 이 기간(일)이 지난 케이스의 원문·주소를 제자리 가명화(승격 지표는 남는다). 비우면 끔. 켜기 전에 치명 오류 평가 건을 내보낸다
RETENTION_DAYS=

# --- npm run sim ---
# 주입 대상 서버(기본 http://localhost:$PORT)
SIM_URL=

# --- node scripts/inbound-imap.js (로컬 E2E: 메일함 → /api/inbound). 로그인은 SMTP_USER·SMTP_PASS ---
# 기본 imap.gmail.com
IMAP_HOST=
# 기본 993(TLS)
IMAP_PORT=
# 기본 INBOX. 읽기 전용(EXAMINE)으로 연다
IMAP_MAILBOX=
# 이 주소로 온 메일만 넘긴다(예: 본인+cs@gmail.com). IMAP_ALLOWED_FROM 에 있으면 시작 거부(메일 루프)
IMAP_TO=
# 쉼표. 이 주소가 보낸 메일만 넘긴다(미러 모드에선 쓰지 않는다)
IMAP_ALLOWED_FROM=
# 넘길 채널(기본 support)
IMAP_CHANNEL=
# 비우면 시연 모드. mirror = 공유 메일함을 읽기 전용으로 미러(아무 발신자나 받고 IMAP_TO·SMTP_FROM 발신은 뺀다, 재시작 뒤 이어 읽기).
# mirror 는 서버와 어댑터 모두 MAIL_PROVIDER=mock + AUTO_SEND=0 + SHADOW_CHANNELS 에 IMAP_CHANNEL 이 있어야 시작한다
# (production 이면 ALLOW_MOCK_MAIL=1 도). 서버는 이 조건이 아닌 미러 메일을 저장하지 않고 503 으로 돌려보낸다 — 서버와 어댑터는 같은 env 파일로
IMAP_MODE=
# 수신 메일 서버의 authserv-id(예: mx.google.com). 이 id 의 맨 위 Authentication-Results 의 dmarc 결과를 발신자 인증으로 넘긴다. 비우면 안 넘김
IMAP_AUTHSERV_ID=

# --- node scripts/inbound-ses.js (AWS: SES 수신 → SQS 알림 → S3 원문 → /api/inbound). POST 대상은 SIM_URL, 시크릿은 INBOUND_SECRET(필수) ---
# 서명·엔드포인트 리전(기본 ap-northeast-2)
AWS_REGION=
# 로컬 시험용 자격 증명. 비우면 EC2 인스턴스 역할(IMDSv2). EC2 에서는 비운다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# SES 알림을 받는 SQS 큐 URL(필수)
SES_QUEUE_URL=
# SES 가 원문 MIME 을 쓰는 버킷 이름(필수)
SES_BUCKET=
# 객체 키 접두어(기본 inbound/). 이 밖의 키는 받지 않는다
SES_PREFIX=
# 받는주소=채널 쉼표 목록(필수). 예 support@mirror.acme.example=support. 이 주소들과 SMTP_FROM 발신은 넘기지 않는다
SES_CHANNELS=
# 비우거나 mirror. mirror 는 MAIL_PROVIDER=mock + AUTO_SEND=0 + 매핑된 채널 전부 SHADOW_CHANNELS 에 있어야 시작한다
SES_MODE=
